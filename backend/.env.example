PORT=3001
NODE_ENV=development

# Neon / PostgreSQL Database
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&connect_timeout=30&pool_timeout=30&connection_limit=20"

# LLM & Embeddings (OpenAI compatible API)
AICREDITS_API_KEY="your-api-key"
AICREDITS_BASE_URL="https://api.aicredits.in/v1"

# Vector Database (Qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# Object Storage (AWS S3)
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="your-bucket-name"

# Authentication (Clerk)
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# BullMQ Redis Queue
REDIS_URL="redis://127.0.0.1:6379"

# YouTube Transcript Provider (optional fallback)
SUPADATA_API_KEY=""
