generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notebook {
  id             String           @id @default(uuid())
  name           String
  isPinned       Boolean          @default(false)
  ownerId        String           @default("default-user")
  createdAt      DateTime         @default(now())
  sources        Source[]
  queries        Query[]
  flashcardDecks FlashcardDeck[]
  quizzes        Quiz[]
  mindMaps       MindMap[]
  roadmaps       Roadmap[]
  overview       NotebookOverview?
}

model Source {
  id             String       @id @default(uuid())
  notebookId     String
  notebook       Notebook     @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  type           String       // PDF, TEXT, URL, YOUTUBE, VTT
  originalUri    String
  title          String?
  status         String       @default("UPLOADING") // UPLOADING, EXTRACTING, CHUNKING, EMBEDDING, READY, FAILED
  statusDetail   String?
  rawContentRef  String?
  createdAt      DateTime     @default(now())
  indexedAt      DateTime?
  chunks         Chunk[]
}

model Chunk {
  id          String   @id @default(uuid())
  sourceId    String
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  notebookId  String
  text        String
  chunkIndex  Int
  location    String   // JSON string representing location per type
  createdAt   DateTime @default(now())

  @@index([notebookId])
  @@index([sourceId])
}

model Query {
  id          String   @id @default(uuid())
  notebookId  String
  notebook    Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  question    String
  createdAt   DateTime @default(now())
  answer      Answer?
}

model Answer {
  id         String   @id @default(uuid())
  queryId    String   @unique
  query      Query    @relation(fields: [queryId], references: [id], onDelete: Cascade)
  text       String
  citations  String   // JSON string: [{ chunkId, sourceId, snippet }]
  createdAt  DateTime @default(now())
}

model FlashcardDeck {
  id          String   @id @default(uuid())
  notebookId  String
  notebook    Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  sourceIds   String   // JSON array of source IDs used for generation
  title       String
  cards       String   // JSON array of { id, question, answer }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([notebookId])
}

model Quiz {
  id          String   @id @default(uuid())
  notebookId  String
  notebook    Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  sourceIds   String   // JSON array of source IDs
  title       String
  questions   String   // JSON array of { id, prompt, options, correctOptionId }
  createdAt   DateTime @default(now())

  @@index([notebookId])
}

model MindMap {
  id          String   @id @default(uuid())
  notebookId  String
  notebook    Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  sourceIds   String   // JSON array of source IDs
  title       String
  root        String   // JSON representation of MindMapNode tree
  createdAt   DateTime @default(now())

  @@index([notebookId])
}

model Roadmap {
  id         String         @id @default(uuid())
  notebookId String
  notebook   Notebook       @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  sourceId   String         // the youtube_playlist source id
  title      String
  stages     RoadmapStage[]
  createdAt  DateTime       @default(now())

  @@index([notebookId])
}

model RoadmapStage {
  id               String   @id @default(uuid())
  roadmapId        String
  roadmap          Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  order            Int
  title            String
  description      String
  estimatedMinutes Int
  outcomes         String   // JSON array of strings
  videoIds         String   // JSON array of strings
  completed        Boolean  @default(false)

  @@index([roadmapId])
}

model NotebookOverview {
  id                 String   @id @default(uuid())
  notebookId         String   @unique
  notebook           Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  sourceIds          String   // JSON array of strings
  title              String
  summaryMarkdown    String
  suggestedQuestions String   // JSON array of exactly 3 strings
  generatedAt        DateTime @default(now())
}
